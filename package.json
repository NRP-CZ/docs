  },
  "homepage": "https://github.com/shuding/nextra-docs-template#readme",
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^16.1.4",
    "next-mdx-remote": "^4.4.1",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-pretty-code": "^0.14.3",
