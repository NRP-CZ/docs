    "postbuild": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-llms.mjs && pagefind --site out --output-path out/_pagefind",
    "llms": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-llms.mjs"
  },
  "repository": {
